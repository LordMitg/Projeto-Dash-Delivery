# ========== DATABASE ==========
# PostgreSQL local (padrão para desenvolvimento)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:password@localhost:5432/delivery_erp"

# ========== AUTHENTICATION ==========
# JWT Secret - Gerar novo com: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="7d"

# ========== SERVER ==========
PORT=3001
NODE_ENV="development"

# ========== OPTIONAL: INVOICE PROCESSING (NF-e) ==========
# Ambiente SEFAZ para integração futura
SEFAZ_ENVIRONMENT="homolog"

# ========== OPTIONAL: PRINTING (ESC/POS) ==========
# Caminho da impressora térmica (USB)
# Windows: \\.\USB001 ou \\.\LPT1
# Linux:   /dev/usb/lp0 ou /dev/ttyUSB0
PRINTER_PORT="\\.\USB001"
