# ==============================================================
#  ERP Delivery - variaveis do backend
#  Copie este arquivo para backend/.env e ajuste os valores.
# ==============================================================

# --------------------------------------------------------------
#  BANCO DE DADOS (Neon - na nuvem)
# --------------------------------------------------------------
# Cole aqui a string de conexao que o Neon mostra no botao "Connect"
# do painel do projeto. Ela precisa:
#   - ficar em UMA SO LINHA, entre aspas duplas
#   - terminar com ?sslmode=require   (o Neon so aceita conexao segura)
#
# Exemplo do formato (NAO use este endereco, ele nao existe):
#   postgresql://neondb_owner:senha123@ep-cool-mode-12345678.sa-east-1.aws.neon.tech/neondb?sslmode=require
#
# Se a criacao das tabelas travar, use no painel do Neon a opcao
# "Direct connection" (endereco SEM a parte "-pooler").
DATABASE_URL="COLE_AQUI_A_STRING_DO_NEON"

# Para conferir se o endereco esta correto antes de subir o sistema:
#   pnpm --filter delivery-erp-backend db:check
#
# ALTERNATIVA - PostgreSQL instalado no proprio PC (funciona offline).
# Para voltar a usar o banco local, comente a linha acima e descomente esta,
# ajustando usuario e senha da sua instalacao:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delivery_erp?schema=public"

# Segredo usado para assinar os tokens de login (minimo 32 caracteres).
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-por-uma-chave-aleatoria-de-no-minimo-32-caracteres"

# Quanto tempo o login dura antes de pedir senha de novo.
JWT_EXPIRES_IN="12h"

# Porta da API.
PORT=3001

NODE_ENV="development"

# Origens autorizadas a chamar a API.
# A porta precisa ser a mesma em que o frontend roda: 3000 (definida em
# frontend/vite.config.ts). Se apontar para outra, a tela abre mas nenhuma
# chamada de API funciona, e o erro aparece so no console do navegador.
#
# Para usar o scanner pelo celular, acrescente o IP do seu PC na rede, no
# formato https://192.168.0.10:3000. Para descobrir o IP:
#   Windows: ipconfig      (procure "Endereco IPv4")
#   Linux/macOS: hostname -I   ou   ifconfig | grep inet
CORS_ORIGINS="https://localhost:3000,http://localhost:3000"

# Custo do hash de senha.
BCRYPT_ROUNDS=10
